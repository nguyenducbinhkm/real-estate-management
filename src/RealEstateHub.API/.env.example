# Sao chép file này thành .env (cùng thư mục) rồi điền giá trị thật. File .env đã được .gitignore bỏ qua.
# Supabase Storage dùng để lưu ảnh đại diện người dùng. Bucket cần để chế độ Public.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<secret key – chỉ dùng ở backend, không đưa lên git>
SUPABASE_BUCKET=avt_real_estate
